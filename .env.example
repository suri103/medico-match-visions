# Razorpay (India payments) — https://dashboard.razorpay.com/app/keys
# KEY_ID is publishable and safe in the browser bundle. The KEY_SECRET must only
# live on the server (see server/.env.example). Empty/unset → sandbox simulator.
VITE_RAZORPAY_KEY_ID=

# Backend API that creates Razorpay orders and verifies payment signatures.
# See server/README.md for the reference server.
VITE_API_BASE_URL=

# Development convenience: set to "true" to open every page without signing in.
# `vite.config.ts` STRIPS this flag from production bundles, so it can never
# reach a shipped artifact — but keep it false for clarity.
VITE_DEV_SKIP_AUTH=false

# Support inbox shown on the Help page (defaults to support@medicomatch.in).
VITE_SUPPORT_EMAIL=

# Astrology consultation feature gate. Set to "true" to enable the /astrology
# page + consultation booking. Off by default (feature is compiled out of the
# production bundle). Requires the backend ASTROLOGY_ENABLED=true to sell.
VITE_ASTROLOGY_ENABLED=false