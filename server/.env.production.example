# =============================================================================
# MedicoMatch — Railway backend (production values).
# Copy to the Railway service's Variables tab (Dashboard -> Service ->
# Variables -> Raw Editor, paste the whole file). NEVER commit real values.
#
# Fill-in checklist (Phase 3 SHIP):
#   [ ] Supabase -> Settings -> Database: paste the SESSION POOLER URI into
#       DATABASE_URL (port 5432 — see the note on DATABASE_URL below; the
#       transaction pooler on 6543 drops LISTEN/NOTIFY and advisory locks).
#   [ ] Razorpay Dashboard -> Settings -> API Keys: live KEY_ID + KEY_SECRET.
#   [ ] Razorpay Dashboard -> Settings -> Webhooks: add
#       https://<railway-domain>/api/webhooks/razorpay subscribed to
#       payment.captured + refund.processed; paste the secret into
#       RAZORPAY_WEBHOOK_SECRET.
#   [ ] Resend (https://resend.com): API key + verified sending domain that
#       matches EMAIL_FROM.
#   [ ] Roll (openssl rand -hex 32) a fresh ACTIVATION_SECRET per environment.
#       Rotating it later invalidates every session by design (break-glass).
#   [ ] ADMIN_EMAILS: exact operator addresses (become ROOT at boot).
# =============================================================================

NODE_ENV=production

# Public origin of the SPA (Vercel or Railway static). Drives CORS +
# emailed verification/reset links. Must be https (boot refuses otherwise).
APP_URL=https://app.medicomatch.in

# Extra CORS origins (comma-separated) on top of APP_URL, e.g. a preview URL
# or a second frontend host. Trailing slashes are stripped at boot.
CORS_ORIGINS=

# Supabase Postgres connection string — use the Supavisor SESSION pooler
# (port 5432, user postgres.<project-ref>), NOT direct (IPv6-only db.* host
# fails when egress has no IPv6 route) and NOT the transaction pooler
# (port 6543 drops LISTEN/NOTIFY + advisory locks). REQUIRED — the server
# boot-refuses without a database.
# Shape: postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.hlcbtjpdhtxlirmeghra:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# TLS to Supabase is on by default (rejectUnauthorized). Leave PGSSLMODE
# unset unless you run behind a TLS-terminating proxy you control.
# PGSSLMODE=

# Razorpay live credentials. KEY_ID is also shipped in the SPA build as
# VITE_RAZORPAY_KEY_ID. KEY_SECRET must never leave Railway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Must be unset/false here — the server boot-refuses if simulation is on.
# RAZORPAY_SIMULATE=

# Session + activation-token signing key. Required in production.
ACTIVATION_SECRET=

# Outbound email (verification / reset / digests) — see RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_FROM=MedicoMatch <no-reply@medicomatch.in>
SUPPORT_EMAIL=

# SMS provider for phone OTPs (optional). Until set, OTP codes fall back to
# the account email address (documented launch behaviour).
SMS_PROVIDER=
MSG91_API_KEY=

# Supabase Storage for profile photos (optional but recommended — otherwise
# bounded data URLs land in Postgres).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Product decisions (safe defaults ship; flip per launch plan).
# Gate member interactions behind verified email? Default FALSE keeps
# verification as a trust badge; TRUE hard-gates browse/interests/chat/etc.
REQUIRE_VERIFIED_INTERACT=false
ASTROLOGY_ENABLED=false
REPORTS_ENABLED=false

# Demo fixtures (17 sample doctor profiles + 4 demo events from schema.sql).
# Audit H5: DEFAULT FALSE for production. The fixtures are fabricated "verified
# doctors"; with the seed ON they exist as real rows in the production database
# and are served by the profile-detail route (browse hides is_sample, the detail
# route does not). Set this to "true" ONLY in staging/demo environments.
# NOTE: with 0 real members, browse is EMPTY on launch day — that is the honest
# state, not a bug.
SEED_SAMPLE_DATA=false

# Retention windows (days) for the boot-time pruners.
ADMIN_AUDIT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90

# Rate-limiting and profile-row budgets.
RATE_LIMIT_MAX=30
USER_RATE_LIMIT_MAX=60
BROWSE_DAILY_MAX=1000
ADMIN_FLAG_TTL_MS=30000

# Local JSON fallback store — unused once DATABASE_URL is set.
# DATA_DIR=./data

# Test-only kill-switches. NEVER set in production (boot refuses to start).
# DISABLE_POW=
# DISABLE_DIGEST=
