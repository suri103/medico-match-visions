# Razorpay credentials - https://dashboard.razorpay.com/app/keys
# KEY_ID is publishable. KEY_SECRET must NEVER leave this server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signature secret (Razorpay Dashboard -> Webhooks). Without it the
# /api/webhooks/razorpay endpoint returns 503 and grants rely solely on
# verify-time capture recording.
RAZORPAY_WEBHOOK_SECRET=

# Supabase Postgres connection string. REQUIRED in production (fail-closed
# boot). Use the SUPAVISOR SESSION pooler (port 5432) unless your host has
# proven IPv6 egress — see the comment at isRemoteHost() in src/db.mjs and
# DEPLOYMENT.md. The direct db.*.supabase.co hostname is IPv6-only, and
# Railway's egress here has no IPv6 route (connect ENETUNREACH on port 5432
# means exactly that). Session mode preserves LISTEN/NOTIFY + advisory
# locks; the TRANSACTION pooler (port 6543) does NOT and must never be used.
# Session-pooler URI shape: postgres.<project-ref>:<pw>@<region>.pooler.supabase.com:5432/postgres
# Local dev/tests may omit it -> JSON-store fallback mode.
DATABASE_URL=

# Session + activation token signing key. Required in production.
ACTIVATION_SECRET=

# When keys are missing, orders are simulated so local development works.
RAZORPAY_SIMULATE=true

# Where the SPA is hosted (CORS origin + emailed link base URL).
APP_URL=http://localhost:8080

# Outbound email (verification / password reset / support inbox / renewal digest).
RESEND_API_KEY=
EMAIL_FROM=MedicoMatch <no-reply@medicomatch.in>

# Support inbox destination for POST /api/support (defaults to EMAIL_FROM).
SUPPORT_EMAIL=

# SMS provider for phone OTP delivery. Until set, OTP codes are emailed to the
# account address as a documented launch fallback (see POST /api/phone/request).
# Only msg91 is implemented; TWILIO_* below are reserved (no code path yet —
# setting them alone keeps the email fallback, it does not send SMS).
SMS_PROVIDER=
MSG91_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Comma-separated emails auto-promoted to ROOT admin at boot (idempotent).
# Root admins — not ordinary admins — manage the admin roster itself.
ADMIN_EMAILS=

# H-2 (audit): when "true", unverified accounts can sign in and manage their own
# profile/quota but CANNOT interact with other members (browse, interests,
# chat, video dates, contact reveal, kundali reports -> 403 email_unverified).
# SAFE DEFAULT: "false" (verification is a trust badge, not a hard gate).
REQUIRE_VERIFIED_INTERACT=false

# Sample/seed FIXTURES — the 17 demo doctor profiles and 4 organiser-less
# demo events shipped in schema.sql. They are markers (profiles.is_sample=TRUE)
# and are ALREADY excluded from every browse path by default (HIDE_SAMPLE_PROFILES
# unset). Set SEED_SAMPLE_DATA=false to omit them entirely: the boot migration
# then skips the seed blocks AND purges any already-seeded rows (cascading
# dependents). Plans and coupons are real config and are never affected.
SEED_SAMPLE_DATA=true

# Dev/staging only: set to "false" to let the sample catalog appear in browse.
# NEVER set this in production — fabricated profiles must not look like members.
# HIDE_SAMPLE_PROFILES=false

# Boot-time retention for admin_audit_log (default 365 days, set 2555 for 7yr).
ADMIN_AUDIT_RETENTION_DAYS=365

# Boot-time retention for the notifications feed (default 90 days).
NOTIFICATION_RETENTION_DAYS=90

# H-NEW-1: per-user DAILY row budget for /api/profiles (default 1000 rows/day).
BROWSE_DAILY_MAX=1000

# Port for the server.
PORT=3001

# Runtime mode: "production" enables fail-closed boot checks (required).
NODE_ENV=

# Object storage for profile photos (optional). Without these, uploads fall
# back to bounded data URLs stored directly in Postgres (<= ~2 MB).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Extra comma-separated CORS origins (defaults to APP_URL).
CORS_ORIGINS=

# Directory for the dev/test JSON-store fallback mode (no DATABASE_URL).
DATA_DIR=./data

# Astrology consultation feature gate. Set to "true" to sell astrologer SKUs.
# Off by default (SKUs omitted from the catalog -> create-order rejects them).
# Also set VITE_ASTROLOGY_ENABLED=true in the frontend build to ship the UI.
ASTROLOGY_ENABLED=false

# Detailed Kundali Match Report (₹499). Off by default; set to "true" to sell.
REPORTS_ENABLED=false

# Rate limiting (requests/min). Defaults 30 (IP) / 60 (authed user).
RATE_LIMIT_MAX=30
USER_RATE_LIMIT_MAX=60

# Admin flag cache TTL in ms (default 30000). Shorter picks up SQL-side roster
# changes faster; longer reduces per-request DB reads. NOTE (audit M-5): make
# admin roster changes through the API (promote/demote endpoints) — they
# invalidate the cache synchronously; direct SQL edits take up to TTL to apply.
ADMIN_FLAG_TTL_MS=30000

# Test-only kill-switches. NEVER set in production (boot refuses to start):
# DISABLE_POW=true disables registration PoW, DISABLE_DIGEST=true silences digests.
# DISABLE_POW=
# DISABLE_DIGEST=
