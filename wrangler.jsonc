{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medico-match-visions",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
    // Security headers for Cloudflare Pages/Workers Assets are defined in public/_headers
    // and copied to ./dist/_headers at build time (CSP, HSTS, X-Frame-Options, etc.).
  }
}
